{
  "name": "hayakit-mcp",
  "version": "1.0.1",
  "description": "Offline Japanese/Taiwan era, craft, booklet imposition, camping, and cassette calculators for MCP.",
  "mcpName": "com.hayakit/calculators",
  "type": "module",
  "license": "MIT",
  "homepage": "https://hayakit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/changrun1/hayakit-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "calculators",
    "japanese-era",
    "wareki",
    "craft",
    "booklet",
    "camping",
    "cassette"
  ],
  "bin": {
    "hayakit-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" && node -e \"const fs=require('fs');const p='dist/index.js';fs.chmodSync(p,0o755);\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/smoke.mjs",
    "pack:mcpb": "node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "latest",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "zod": "^3.25.0"
  }
}
